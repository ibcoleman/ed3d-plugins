{
    "hooks": {
        "preToolUse": [
            {
                "matcher": "[Ee]dit|[Ww]rite|MultiEdit|NotebookEdit|[Cc]reate|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/adversary-write-guard.py\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "agentStop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-review-loop.py\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-review-loop.py\"",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
